{% extends 'blog/base.html.j2' %}
{# One post. Rendered to blog/<slug>.html, and by the editor's preview (preview=True, nothing written). #}
{% block title %}{{ (post.title or 'Untitled') | typo | e }} · Alexander Spangher{% endblock %}
{% block meta %}
    {% if preview %}
    <meta name="robots" content="noindex">
    {% else %}
    <link rel="canonical" href="{{ site_url }}{{ post.url }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Alexander Spangher">
    <meta property="og:title" content="{{ post.title | typo | e }}">
    <meta property="og:url" content="{{ site_url }}{{ post.url }}">
    <meta property="article:published_time" content="{{ post.date_iso }}">
    <meta name="twitter:card" content="summary">
    {% if post.subtitle %}
    <meta name="description" content="{{ post.subtitle | typo | e }}">
    <meta property="og:description" content="{{ post.subtitle | typo | e }}">
    {% endif %}
    {% endif %}
{% endblock %}
{% block content %}
      <article class="post">
        <header class="post-header">
          <h1 class="post-title">{{ (post.title or 'Untitled') | typo | e }}</h1>
          {% if post.subtitle %}
          <p class="post-subtitle">{{ post.subtitle | typo | e }}</p>
          {% endif %}
          <p class="post-meta"><time datetime="{{ post.date_iso }}">{{ post.date_display }}</time></p>
        </header>
        <div class="post-body">
{{ post.html | safe }}
        </div>
        <footer class="post-footer">
          <a href="/blog/">&larr; All posts</a>
        </footer>
      </article>
{% endblock %}
