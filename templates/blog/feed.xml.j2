<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ author | e }}: Blog</title>
  <link href="{{ site_url }}/blog/feed.xml" rel="self"/>
  <link href="{{ site_url }}/blog/"/>
  <id>{{ site_url }}/blog/</id>
  <updated>{{ posts[0].date_iso }}T00:00:00Z</updated>
  <author><name>{{ author | e }}</name></author>
  {% for post in posts %}
  <entry>
    <title>{{ post.title | typo | e }}</title>
    <link href="{{ site_url }}{{ post.url }}"/>
    <id>{{ site_url }}{{ post.url }}</id>
    <published>{{ post.date_iso }}T00:00:00Z</published>
    <updated>{{ post.date_iso }}T00:00:00Z</updated>
    {% if post.subtitle %}
    <summary>{{ post.subtitle | typo | e }}</summary>
    {% endif %}
    <content type="html">{{ post.feed_html | e }}</content>
  </entry>
  {% endfor %}
</feed>
