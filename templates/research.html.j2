    {{ pub_tree('cs', 'topics',
                ['tacit', 'planning', 'discourse', 'sequence', 'other'],
                {'tacit': 'Tacit Knowledge', 'planning': 'Planning', 'discourse': 'Discourse and Emulation',
                 'sequence': 'Sequence Modeling', 'other': 'Other'}) }}
    {{ pub_tree('cj', 'stages',
                ['news-finding', 'source-finding', 'story-structuring', 'story-editing', 'information-ecosystem', 'other'],
                {'news-finding': 'News Finding', 'source-finding': 'Source Finding', 'story-structuring': 'Story Structuring',
                 'story-editing': 'Story Editing', 'information-ecosystem': 'Information Ecosystem', 'other': 'Outside Journalism'}) }}
  </div>
