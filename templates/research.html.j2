<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Research</title>
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/all.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/papers.css" rel="stylesheet" type="text/css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
      #top-header {
          margin-top: 0;
      }

    </style>

    <script src="/assets/js/research-cards.js"></script>
    <script>
      $(document).ready(function () {
          var getUrlParameter = ResearchCards.getUrlParameter;

          // ---------- Lens switch (?lens=cs | ?lens=cj; defaults to cs) ----------
          // Everything lens-specific carries class lens-cs or lens-cj: the intro paragraph,
          // the category cards and the "All Publications" tree.
          var LENS_LABELS = { cs: 'Computer Science Lens', cj: 'Computational Journalism Lens' };
          var activeLens = 'cs';

          function applyLens(lens) {
              activeLens = lens === 'cj' ? 'cj' : 'cs';
              $('#lens').text(LENS_LABELS[activeLens]);
              $('.lens-cs').toggle(activeLens === 'cs');
              $('.lens-cj').toggle(activeLens === 'cj');
          }

          applyLens(getUrlParameter('lens'));

          $('.lens-switch').on('click', function (event) {
              event.preventDefault();
              var lens = $(this).data('lens');
              applyLens(lens);
              var url = new URL(location.href);
              url.searchParams.set('lens', lens);
              history.replaceState(null, '', url.toString());
          });

          // Deep link: research.html?cat=tacit (or ?cat=news-finding) opens that card, switching lens if needed.
          var catParam = getUrlParameter('cat');
          if (catParam) {
              var $target = $('.category-card[data-cat="' + catParam + '"]');
              if ($target.length) {
                  if ($target.data('lens') !== activeLens) { applyLens($target.data('lens')); }
                  ResearchCards.setCardOpen($target, true);
              }
          }

          // Links to a paper (#cs-paper-<id> or #cj-paper-<id>) switch lens if the paper lives in
          // the other tree, then expand the sections that contain it and scroll to it.
          function revealPaper(hash) {
              var match = /^#(cs|cj)-paper-/.exec(hash || '');
              if (!match) { return; }
              if (match[1] !== activeLens) { applyLens(match[1]); }
              ResearchCards.revealPaper(hash);
          }

          revealPaper(location.hash);
          $(window).on('hashchange', function () { revealPaper(location.hash); });
      });
    </script>
  </head>

  <body class="research">
    {% include 'includes/site-header.html' %}

    {# ================= Macros ================= #}

    {% from 'includes/research_macros.html.j2' import paper_entry, plink, card with context %}


    {# The two-level publication tree for one lens: section, then group (by `groupfield`, i.e. topics or stages). #}
    {% macro pub_tree(lens, groupfield, order, names) %}
    {% set section_defs = [
        ('first-author', 'First Author'),
        ('thesis', 'Ph.D. Thesis'),
        ('middle-author', 'Publications (Middle Author)'),
        ('in-submission', 'Publications (In Submission)'),
    ] %}
    <div class="pub-tree lens-{{ lens }}" id="pubs-{{ lens }}">
    {% for key, label in section_defs %}
      {% set section_papers = papers | selectattr('section', 'equalto', key) | list %}
      {% if section_papers %}
      {% set ns = namespace(groups=[]) %}
      {% for t in order %}
        {% set group = section_papers | selectattr(groupfield ~ '.0', 'equalto', t) | list %}
        {% if group %}{% set ns.groups = ns.groups + [(t, group)] %}{% endif %}
      {% endfor %}
      <div class="pub-section">
        <button type="button" class="pub-toggle pub-section-toggle" aria-expanded="false" aria-controls="pubs-{{ lens }}-{{ key }}-body">
          <span class="pub-chevron" aria-hidden="true"></span>
          <span class="pub-label">{{ label }}</span>
          <span class="pub-count">{{ section_papers | length }}</span>
        </button>
        <div class="pub-body" id="pubs-{{ lens }}-{{ key }}-body">
        {% if ns.groups | length == 1 %}
          {% for p in ns.groups[0][1] %}
          {{ paper_entry(p, lens) }}
          {% endfor %}
        {% else %}
          {% for t, group in ns.groups %}
          <div class="pub-group">
            <button type="button" class="pub-toggle pub-group-toggle" aria-expanded="false" aria-controls="pubs-{{ lens }}-{{ key }}-{{ t }}-body">
              <span class="pub-chevron" aria-hidden="true"></span>
              <span class="pub-label">{{ names[t] }}</span>
              <span class="pub-count">{{ group | length }}</span>
            </button>
            <div class="pub-body" id="pubs-{{ lens }}-{{ key }}-{{ t }}-body">
            {% for p in group %}
            {{ paper_entry(p, lens) }}
            {% endfor %}
            </div>
          </div>
          {% endfor %}
        {% endif %}
        </div>
      </div>
      {% endif %}
    {% endfor %}
    </div>
    {% endmacro %}

  <div class="main">    
    <h1 id="top-header">Academic Research</h1>

    <div id="lens-description" style="background-color: #f0f0f0; padding: 10px; font-size: 0.9em;">
        My research breaks down into two lenses: <a href="research.html?lens=cs" class="lens-switch" data-lens="cs">[Computer Science]</a> | <a href="research.html?lens=cj" class="lens-switch" data-lens="cj">[Computational Journalism]</a>.
        <br>
        You are currently viewing the <b id="lens">Computer Science Lens</b>. Click on the other lens to view it.
    </div>
    <p></p>

    <div id="computer-science-lens" class="lens-cs">
        <p>
            For AI to play a more integrated role in human tasks, it must align with human values and decision-making processes. Doing
            so, I believe, requires a radically different approach to conceptualizing and training AI; it requires an AI that understands, on a
            fundamental level, why humans make the decisions we do. My work illuminates this process through simply observing the creative outputs humans produce. 
        </p>
    </div>
    <div id="comp-journalism-lens" class="lens-cj">
        <p>
            I imagine a society where professional journalists can produce more higher-quality information at lower costs, improving our information ecosystem, better informing the public and improving our democracy. 
            My work has targeted different steps in the news gathering process, from finding story ideas, to sourcing, to structuring the finished story, to editing it, and I develop computational methods to improve each step.
        </p>
    </div>

    {#
      Research-category cards. Each card is an overview: a stance, then the arc of findings from the present
      backwards, linking to papers with plink(lens, paper-id, text). Paper ids are in data/papers.yaml.
      Icons live in assets/img/research/<file> (480x480); swap a file to change an icon.
    #}

    {# ---------- Computer Science lens ---------- #}
    <div class="category-list lens-cs">

      {% call card('cs', 'tacit', 'tacit.png', 'Verifiable, Articulable, and Tacit Components of Preference', 'Tacit Knowledge', 'Measuring what humans know but cannot say') %}
        <p>I am currently developing a line of work exploring <a href="https://www.goodreads.com/book/show/225665.Tacit_Dimension">tacit knowledge</a>: how to measure it, learn it and understand what role it has in human tasks.</p>
        <p>Tacit knowledge, I believe, is how humans construct <a href="https://www.goodreads.com/book/show/66322.Creativity">taste</a>, <a href="https://www.goodreads.com/book/show/12073.Philosophical_Investigations">meaning</a> and <a href="https://www.goodreads.com/book/show/19068.The_Nicomachean_Ethics">values</a>; our models do not currently acquire tacit knowledge in the same ways humans do, and I believe that is the root of safety and capability failures at the frontier.</p>
        <p>I am currently asking {{ plink('cs', 'verifiable-tacit', 'how much human preference') }} can be captured by rubrics and verifiers across seven creative domains (journalism, law, math, code, etc.) and find robust evidence of tacit knowledge, even in math and code. This builds from a long line of observations I have made in how human preference gets encoded in {{ plink('cs', 'spatial-layouts', 'homepages') }}, {{ plink('cs', 'tracking-newsworthiness', 'news coverage selections') }} and {{ plink('cs', 'identifying-sources', 'source selections') }}. Understanding how these qualitative shared values arise, and how they can be encoded, presents in my mind the biggest challenge to continued frontier model development.</p>
      {% endcall %}

      {% call card('cs', 'planning', 'planning.png', 'Sequentially Controlled Text Generation', 'Planning', 'Learning how humans plan before they act') %}
        <p>I believe modern agentic systems benefit when considering more elements of planning. Goal-directed RL, constrained planning and latent learning are all directions that I am interested in considering.</p>
        <p>My prior work in this domain has considered hierarchical approaches to mapping trajectories, learning from human planning processes and fair low-level plans.</p>
        <p>Most recently, I have studied planning where the plan is a conversation: in {{ plink('cs', 'newsinterview', 'NewsInterview') }}, we built a simulated interviewing environment from 40,000 journalistic interviews and found that LLM interviewers rabbit-hole and fail to pivot, a long-horizon planning failure that no single-turn benchmark would show. Before that, I asked whether LLMs {{ plink('cs', 'llms-plan-like-writers', 'plan like human writers') }} when choosing an angle on a press release (they match us better on angles than on sources, and are less creative at both), and treated a journalist's choice of sources as a {{ plink('cs', 'explaining-mixtures', 'latent plan') }} that can be recovered from the finished article.</p>
        <p>That work grew out of earlier attempts to impose structure on generation and to read structure off of human drafts: {{ plink('cs', 'seq-controlled', 'sequentially controlled text generation') }} asks a model to follow a discourse plan sentence by sentence, and {{ plink('cs', 'newsedits', 'NewsEdits') }} captures 4.6M article versions so we can watch a writer's plan unfold edit by edit. The earliest thread, {{ plink('cs', 'actionable-recourse', 'actionable recourse') }}, is planning at its most constrained: what is the cheapest sequence of changes a person can make to flip a classifier's decision?</p>
      {% endcall %}

      {% call card('cs', 'discourse', 'discourse.png', 'LegalDiscourse: Interpreting When Laws Apply and To Whom', 'Discourse and Emulation', 'Reconstructing the process behind the artifact') %}
        <p>Humans leave traces of our own planning and ideation in the artifacts we create: you or I could look at a scientific paper and reconstruct many steps in its execution (explicit and implicit), based on what we call <i>discourse cues</i>. Cognitive scientists call this <i>emulation</i>, or the ability to (a) work backwards and recreate missing steps in the state-and-action sequences of others and (b) recreate them.</p>
        <p>I centered my thesis around this topic: that our ML systems can learn better from human actions if we take some of these processes better into account.</p>
        <p>My {{ plink('cs', 'thesis', 'thesis') }} frames this as emulation learning: infer the actions and rewards behind a finished artifact, then learn to plan from them. The most recent pieces read discourse to recover intent: {{ plink('cs', 'newsedits-2', 'NewsEdits 2.0') }} separates factual from stylistic edits and shows an article's own language predicts which facts will change, and {{ plink('cs', 'discosum', 'DiscoSum') }} plans a discourse structure before it summarizes, so a story keeps its shape across platforms. The same move works outside news: {{ plink('cs', 'patentedits', 'which patent claims survive examination') }} is predictable from textual entailment against the prior art.</p>
        <p>The discourse machinery itself came first. {{ plink('cs', 'legaldiscourse', 'LegalDiscourse') }} asks when a law applies and to whom, and answers with a span-and-relation schema that journalists then used, through {{ plink('cs', 'statecensuslaws', 'StateCensusLaws.org') }}, to investigate 6,000 census-dependent state laws. Underneath that is the practical problem that discourse datasets are small and their schemas drift, which {{ plink('cs', 'multitask-discourse', 'multitask learning') }} helps with where the usual low-resource tricks do not, and a {{ plink('cs', 'news-discourse-patterns', 'roadmap') }} for why the structure of a news article is a scaffold for computational journalism in the first place.</p>
      {% endcall %}

      {% call card('cs', 'sequence', 'sequence.png', 'Stay on Topic with Classifier-Free Guidance', 'Sequence Modeling', 'Structure in sequences, in language and beyond') %}
        {# DRAFT: the arc paragraphs below were written by Claude from the paper abstracts. Edit freely. #}
        <p>I have been fascinated by sequence modeling both in and outside of language, and what this tells us about fundamental similarities between domains.</p>
        <p>Most recently, with EleutherAI, we trained autoregressive transformers on {{ plink('cs', 'piano-ssl', '60,000 hours of transcribed solo piano') }}; the models produce coherent continuations and MIDI embeddings that set the state of the art on music-information-retrieval classification, and {{ plink('cs', 'ghost-in-the-keys', 'Aria-Duet') }} puts one on a Disklavier for a live, turn-taking duet with a human pianist. Before that, we showed that {{ plink('cs', 'cfg', 'classifier-free guidance') }}, borrowed from image diffusion, works for plain language models too: at inference time it buys the accuracy of a model twice the size.</p>
        <p>Outside language and music, the same tools show up in physics and public health: masked autoregressive transformers {{ plink('cs', 'fusion-autoregressive', 'predict plasma disruptions') }} in fusion tokamaks and suggest the plasma carries a long memory, and, early in the pandemic, co-training on event-extraction views let classifiers {{ plink('cs', 'covid-transfer', 'transfer') }} from COVID-19 policy announcements to Twitter discussion of them.</p>
      {% endcall %}

    </div>

    {# ---------- Computational Journalism lens ---------- #}
    <div class="category-list lens-cj">

      {% call card('cj', 'news-finding', 'news-finding.png', 'Spatial Layouts in News Homepages Capture Human Preferences', 'News Finding', 'Which events and documents become news') %}
        <p>Journalists find stories by reading: leaks, bills, court filings, press releases, meeting minutes. Only a sliver of it becomes news, and the judgment of what deserves coverage is one of the most important, and least articulated, decisions in the newsroom.</p>
        <p>Most recently, we showed that editors' judgments are legible in the {{ plink('cj', 'spatial-layouts', 'layout of a homepage') }}: from 3,000 homepages captured twice daily for five years, we learned stable, transferable preferences over what goes where. Before that, we {{ plink('cj', 'tracking-newsworthiness', 'linked San Francisco Chronicle coverage to city-government records') }} and built newsworthiness predictors that expert journalists found helpful 84% of the time, extending an earlier idea of {{ plink('cj', 'newsworthiness-lead-gen', 'training on front pages and transferring to court cases, bills and council minutes') }}.</p>
        <p>Looking at the other end of the pipeline, we asked whether LLMs {{ plink('cj', 'llms-plan-like-writers', 'choose angles on press releases the way reporters do') }}: they are closer to us on angles than on sources, and less creative at both. The newest piece, on {{ plink('cj', 'verifiable-tacit', 'tacit components of preference') }}, treats newsworthiness as one of several human judgments that resist rubrics and verifiers.</p>
      {% endcall %}

      {% call card('cj', 'source-finding', 'source-finding.png', 'A Novel Multi-Document Retrieval Benchmark: Journalist Source-Selection in Newswriting', 'Source Finding', 'Who gets quoted, and why') %}
        <p>Reporting is sourcing. Which people, documents and databases a journalist consults shapes the story more than any sentence they write, and sources tend to be used together in canonical ways.</p>
        <p>{{ plink('cj', 'newsinterview', 'NewsInterview') }} is the most recent step: a simulated interviewing environment built from 40,000 journalistic interviews, in which LLM interviewers rabbit-hole, fail to pivot and leave information on the table. Alongside it, we recast source selection as {{ plink('cj', 'multi-doc-retrieval', 'multi-document retrieval') }} and showed query planners do better when they plan over the discourse role each source will play, and we modeled a journalist's choice of sources as a {{ plink('cj', 'explaining-mixtures', 'latent plan') }} recoverable from the finished article.</p>
        <p>The foundation is the {{ plink('cj', 'identifying-sources', 'largest annotated dataset of informational sources in news') }}, which grew out of {{ plink('cj', 'source-rec-engine', 'first steps toward a source recommendation engine') }} and, before that, a model of articles as {{ plink('cj', 'dont-quote-me', 'mixtures of source types') }} labeled by affiliation and role.</p>
      {% endcall %}

      {% call card('cj', 'story-structuring', 'structuring.png', 'Sequentially Controlled Text Generation', 'Story Structuring', 'How a story is built, sentence by sentence') %}
        <p>A news article has a shape: a main event, context, history, reactions, expectations. Journalists learn this structure by apprenticeship; I want machines to read it off finished stories and to write with it.</p>
        <p>Most recently we took the discourse approach to law: {{ plink('cj', 'legaldiscourse', 'LegalDiscourse') }} parses when a law applies and to whom, and {{ plink('cj', 'statecensuslaws', 'StateCensusLaws.org') }} put those parsers in front of journalists investigating 6,000 census-dependent state laws. In news itself, {{ plink('cj', 'seq-controlled', 'sequentially controlled generation') }} asks a model to follow a discourse plan one sentence at a time and gets closer to human-level writing the more structure it is given.</p>
        <p>Underneath is the practical problem that discourse datasets are small and their schemas drift, which {{ plink('cj', 'multitask-discourse', 'multitask learning') }} helps with where the usual low-resource tricks do not, and the {{ plink('cj', 'news-discourse-patterns', 'roadmap') }} that argued news discourse structure is the scaffold for computational journalism tools in the first place.</p>
      {% endcall %}

      {% call card('cj', 'story-editing', 'editing.png', 'NewsEdits: A News Article Revision Dataset and a Novel Document-level Reasoning Challenge', 'Story Editing', 'How stories change after they are published') %}
        <p>Breaking news is written in versions. Each revision records a decision: a fact that changed, a frame that shifted, a quote that was cut. Those traces are a rare window into the writing process itself.</p>
        <p>Most recently, {{ plink('cj', 'newsedits-2', 'NewsEdits 2.0') }} separates factual updates from stylistic and narrative ones and shows that an article's own language predicts which facts will change, well enough to tell an LLM when to abstain from answering. {{ plink('cj', 'discosum', 'DiscoSum') }} treats re-writing a story for each social platform as a structured edit, planning the discourse structure before summarizing.</p>
        <p>The dataset behind this is {{ plink('cj', 'newsedits', 'NewsEdits') }}, 4.6M versions of 1.2M articles, with tasks that ask models to predict which sentences will be added, deleted or edited next; the same edit-prediction framing carries over to {{ plink('cj', 'patentedits', 'patent claims') }}, where textual entailment against prior art predicts which claims survive examination.</p>
      {% endcall %}

    </div>

    {# ---------- All Publications: one tree per lens; the lens JS shows the active one ---------- #}
    <h2 id="publications-header">All Publications
      <span class="pub-controls"><a href="#" class="pub-expand-all">expand all</a> <span class="nav-sep">|</span> <a href="#" class="pub-collapse-all">collapse all</a></span>
