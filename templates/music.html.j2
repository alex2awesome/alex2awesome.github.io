    <style>
      #top-header {
        margin-top: 0;
      }
    </style>
    <script>
      $(document).ready(function () {
          // Deep links: music.html?cat=cocreation opens that card; #music-paper-<id> reveals a paper.
          var cat = ResearchCards.getUrlParameter('cat');
          if (cat) { ResearchCards.setCardOpen($('.category-card[data-cat="' + cat + '"]'), true); }
          ResearchCards.revealPaper(location.hash);
          $(window).on('hashchange', function () { ResearchCards.revealPaper(location.hash); });
      });
    </script>
